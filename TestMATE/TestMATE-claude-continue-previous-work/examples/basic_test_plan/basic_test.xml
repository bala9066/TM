<?xml version="1.0" encoding="UTF-8"?>
<sequence id="XML-BASIC-001">
  <name>Basic XML Test Sequence</name>
  <version>1.0.0</version>
  <description>Demonstrates XML format for test sequences in TestMATE</description>

  <steps>
    <step id="STEP-001" name="Initialize Test System" type="action" />
    <step id="STEP-002" name="Configure Test Parameters" type="action" />
    <step id="STEP-003" name="Connect to Device Under Test" type="action" />
    <step id="STEP-004" name="Verify Device Connection" type="validation" />
    <step id="STEP-005" name="Apply Power" type="action" />
    <step id="STEP-006" name="Wait for Power Stabilization" type="wait" />
    <step id="STEP-007" name="Measure Operating Voltage" type="measurement" />
    <step id="STEP-008" name="Validate Voltage Within Spec" type="validation" />
    <step id="STEP-009" name="Measure Operating Current" type="measurement" />
    <step id="STEP-010" name="Validate Current Within Spec" type="validation" />
    <step id="STEP-011" name="Run Built-In Self Test" type="action" />
    <step id="STEP-012" name="Validate BIST Results" type="validation" />
    <step id="STEP-013" name="Remove Power" type="action" />
    <step id="STEP-014" name="Disconnect Device" type="action" />
    <step id="STEP-015" name="Finalize Test Report" type="action" />
  </steps>
</sequence>
