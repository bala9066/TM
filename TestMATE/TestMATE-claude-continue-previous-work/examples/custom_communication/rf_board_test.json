{
    "sequenceInfo": {
        "id": "RF-BOARD-001",
        "name": "RF Board Communication Test",
        "description": "Example test sequence for RF board using custom Ethernet/UART communication",
        "version": "1.0.0",
        "author": "TestMATE Development Team"
    },
    "configuration": {
        "ethernet": {
            "protocol": "tcp",
            "ipAddress": "192.168.1.100",
            "port": 5000,
            "timeout": 5000
        },
        "uart": {
            "port": "/dev/ttyUSB0",
            "baudRate": 115200,
            "dataBits": 8,
            "parity": "none",
            "stopBits": 1
        }
    },
    "steps": [
        {
            "type": "Comment",
            "id": "STEP-001",
            "name": "Test Setup",
            "parameters": {
                "comment": "Initialize communication with RF board DUT"
            }
        },
        {
            "type": "UARTConnect",
            "id": "STEP-002",
            "name": "Connect to DUT via UART",
            "parameters": {
                "port": "/dev/ttyUSB0",
                "baudRate": 115200
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-003",
            "name": "Verify Device ID",
            "parameters": {
                "operation": "read",
                "address": "0x0000",
                "expectedValue": "0x12345678",
                "mask": "0xFFFFFFFF",
                "description": "Read and verify device ID register"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-004",
            "name": "Check Firmware Version",
            "parameters": {
                "operation": "read",
                "address": "0x0004",
                "expectedValue": "0x00010203",
                "mask": "0xFFFFFFFF",
                "description": "Verify firmware version (1.2.3)"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-005",
            "name": "Enable RF TX",
            "parameters": {
                "operation": "write",
                "address": "0x1000",
                "value": "0x00000001",
                "description": "Enable RF transmitter"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-006",
            "name": "Set TX Frequency",
            "parameters": {
                "operation": "write",
                "address": "0x1004",
                "value": "0x08F0D180",
                "description": "Set frequency to 2.4 GHz (hex: 150000000)"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-007",
            "name": "Set TX Power",
            "parameters": {
                "operation": "write",
                "address": "0x1008",
                "value": "0x00000014",
                "description": "Set TX power to 20 dBm"
            }
        },
        {
            "type": "Wait",
            "id": "STEP-008",
            "name": "Settle Time",
            "parameters": {
                "duration": 100,
                "description": "Wait for TX to stabilize"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-009",
            "name": "Read TX Status",
            "parameters": {
                "operation": "read",
                "address": "0x1010",
                "expectedValue": "0x00000001",
                "mask": "0x00000001",
                "description": "Verify TX is active (bit 0 = 1)"
            }
        },
        {
            "type": "Comment",
            "id": "STEP-010",
            "name": "RF Measurements",
            "parameters": {
                "comment": "At this point, use spectrum analyzer to measure RF output"
            }
        },
        {
            "type": "EthernetConnect",
            "id": "STEP-011",
            "name": "Connect via Ethernet for Data Transfer",
            "parameters": {
                "protocol": "tcp",
                "ipAddress": "192.168.1.100",
                "port": 5000
            }
        },
        {
            "type": "EthernetCommand",
            "id": "STEP-012",
            "name": "Request Test Data",
            "parameters": {
                "packetType": "0x20",
                "payload": [0x01, 0x02, 0x03, 0x04],
                "expectedResponseType": "0xA0",
                "timeout": 5000,
                "description": "Request test data via Ethernet"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-013",
            "name": "Disable RF TX",
            "parameters": {
                "operation": "write",
                "address": "0x1000",
                "value": "0x00000000",
                "description": "Disable RF transmitter"
            }
        },
        {
            "type": "DUTRegisterTest",
            "id": "STEP-014",
            "name": "Verify TX Disabled",
            "parameters": {
                "operation": "read",
                "address": "0x1010",
                "expectedValue": "0x00000000",
                "mask": "0x00000001",
                "description": "Verify TX is inactive (bit 0 = 0)"
            }
        },
        {
            "type": "EthernetDisconnect",
            "id": "STEP-015",
            "name": "Disconnect Ethernet",
            "parameters": {}
        },
        {
            "type": "UARTDisconnect",
            "id": "STEP-016",
            "name": "Disconnect UART",
            "parameters": {}
        }
    ],
    "limits": {
        "totalExecutionTime": 60000,
        "description": "Maximum test execution time in milliseconds"
    }
}
