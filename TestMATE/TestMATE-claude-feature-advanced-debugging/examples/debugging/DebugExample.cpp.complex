/**
 * @file DebugExample.cpp
 * @brief Complete example demonstrating interactive debugging in TestMATE
 * @author TestMATE Development Team
 * @date 2025-11-23
 *
 * This example shows how to use TestMATE's interactive debugging system with:
 * - Breakpoints (step entry, conditional, hit count)
 * - Debug session management
 * - Interactive CLI debugging
 * - Variable inspection
 * - Step-by-step execution
 *
 * Build and run:
 *   cd build
 *   make debug_example
 *   ./bin/debug_example
 */

#include "testmate/debug/Breakpoint.h"
#include "testmate/debug/BreakpointManager.h"
#include "testmate/debug/DebugSession.h"
#include "testmate/debug/DebugCLI.h"
#include "core/execution/TestExecutor.h"
#include "core/test_sequence/TestSequence.h"
#include "core/test_sequence/TestStepBase.h"
#include <iostream>
#include <thread>
#include <memory>

using namespace TestMATE;

// ============================================================================
// Example Test Steps
// ============================================================================

/**
 * @brief Simple test step that simulates voltage measurement
 */
class CVoltageTestStep : public CTestStepBase {
public:
    CVoltageTestStep(const TString& id, const TString& name, TDouble targetVoltage)
        : CTestStepBase(id, name)
        , m_targetVoltage(targetVoltage) {
    }

    CResult Execute(SStepResult& out_result) override {
        // Simulate measurement
        m_measuredVoltage = m_targetVoltage + (rand() % 100 - 50) / 1000.0;  // +/- 50mV variation

        std::cout << "  Measuring voltage: " << m_measuredVoltage << "V (target: " << m_targetVoltage << "V)\n";

        // Check if within tolerance
        TDouble tolerance = 0.1;  // 100mV
        if (std::abs(m_measuredVoltage - m_targetVoltage) <= tolerance) {
            out_result.verdict = ETestVerdict::kPass;
            out_result.message = "Voltage within tolerance";

            // Add measurement
            out_result.measurements.push_back({
                "Voltage",
                m_measuredVoltage,
                "V",
                m_targetVoltage - tolerance,
                m_targetVoltage + tolerance
            });
        } else {
            out_result.verdict = ETestVerdict::kFail;
            out_result.message = "Voltage out of tolerance";
        }

        return TESTMATE_SUCCESS();
    }

    TDouble GetMeasuredVoltage() const { return m_measuredVoltage; }

private:
    TDouble m_targetVoltage{0.0};
    TDouble m_measuredVoltage{0.0};
};

// ============================================================================
// Main Example
// ============================================================================

int main() {
    std::cout << "====================================================\n";
    std::cout << "  TestMATE Interactive Debugging Example\n";
    std::cout << "====================================================\n\n";

    // ------------------------------------------------------------------------
    // Step 1: Create test sequence
    // ------------------------------------------------------------------------
    std::cout << "[1] Creating test sequence...\n";

    CTestSequence sequence("VOLTAGE_TEST", "Voltage Measurement Test Sequence");

    // Add test steps
    auto step1 = std::make_shared<CVoltageTestStep>("STEP-001", "Measure 3.3V Rail", 3.3);
    auto step2 = std::make_shared<CVoltageTestStep>("STEP-002", "Measure 5.0V Rail", 5.0);
    auto step3 = std::make_shared<CVoltageTestStep>("STEP-003", "Measure 12V Rail", 12.0);
    auto step4 = std::make_shared<CVoltageTestStep>("STEP-004", "Measure 1.8V Rail", 1.8);

    sequence.AddStep(step1);
    sequence.AddStep(step2);
    sequence.AddStep(step3);
    sequence.AddStep(step4);

    std::cout << "  Created sequence with " << sequence.GetStepCount() << " steps\n\n";

    // ------------------------------------------------------------------------
    // Step 2: Set up debugging system
    // ------------------------------------------------------------------------
    std::cout << "[2] Setting up debugging system...\n";

    // Create breakpoint manager
    auto breakpointManager = std::make_shared<CBreakpointManager>();

    // Add various types of breakpoints
    std::cout << "  Setting breakpoints:\n";

    // Breakpoint #1: Step entry breakpoint
    auto bp1 = breakpointManager->AddBreakpoint(EBreakpointType::kStepEntry, "STEP-002");
    std::cout << "    [" << bp1 << "] Step entry at STEP-002\n";

    // Breakpoint #2: Conditional breakpoint (break if voltage > 10V)
    auto bp2 = breakpointManager->AddBreakpoint(EBreakpointType::kConditional, "STEP-003");
    SBreakpointCondition condition;
    condition.expression = "voltage > 10.0";
    condition.evaluator = [&step3]() {
        return step3->GetMeasuredVoltage() > 10.0;
    };
    breakpointManager->SetBreakpointCondition(bp2, condition);
    std::cout << "    [" << bp2 << "] Conditional at STEP-003 (voltage > 10.0)\n";

    // Breakpoint #3: Hit count breakpoint (break after 1 hit)
    auto bp3 = breakpointManager->AddBreakpoint(EBreakpointType::kHitCount, "STEP-004");
    breakpointManager->SetBreakpointHitCount(bp3, 1);
    std::cout << "    [" << bp3 << "] Hit count at STEP-004 (after 1 hit)\n";

    std::cout << "\n";

    // Create debug session
    auto debugSession = std::make_shared<CDebugSession>(breakpointManager);

    // Register variables for inspection
    std::cout << "  Registering variables for inspection:\n";
    debugSession->RegisterVariableAccessor("step1_voltage", [&step1]() -> TVariableValue {
        return step1->GetMeasuredVoltage();
    });
    debugSession->RegisterVariableAccessor("step2_voltage", [&step2]() -> TVariableValue {
        return step2->GetMeasuredVoltage();
    });
    debugSession->RegisterVariableAccessor("step3_voltage", [&step3]() -> TVariableValue {
        return step3->GetMeasuredVoltage();
    });
    debugSession->RegisterVariableAccessor("step4_voltage", [&step4]() -> TVariableValue {
        return step4->GetMeasuredVoltage();
    });
    std::cout << "    Registered 4 voltage variables\n\n";

    // Create CLI (for interactive debugging if needed)
    SDebugCLIConfig cliConfig;
    cliConfig.showPrompt = true;
    cliConfig.promptString = "(testmate-dbg) ";

    auto cli = std::make_unique<CDebugCLI>(debugSession, breakpointManager, cliConfig);

    // ------------------------------------------------------------------------
    // Step 3: Create and configure executor
    // ------------------------------------------------------------------------
    std::cout << "[3] Configuring test executor...\n";

    CTestExecutor executor;

    // Set debug session
    executor.SetDebugSession(debugSession);
    std::cout << "  Debug session attached to executor\n";

    // Set callbacks for visibility
    executor.SetStepStartCallback([](TUInt32 index, const TString& name) {
        std::cout << "\n[Executor] Starting step " << index << ": " << name << "\n";
    });

    executor.SetStepCompleteCallback([](TUInt32 index, const STestResult& result) {
        std::cout << "[Executor] Step " << index << " completed: "
                  << (result.verdict == ETestVerdict::kPass ? "PASS" : "FAIL") << "\n";
    });

    std::cout << "\n";

    // ------------------------------------------------------------------------
    // Step 4: Execute with debugging
    // ------------------------------------------------------------------------
    std::cout << "[4] Executing test sequence with debugging...\n";
    std::cout << "    NOTE: Execution will pause at breakpoints\n";
    std::cout << "    You can use the CLI or let it auto-continue\n\n";

    // Start debug session
    debugSession->Start();

    // Start CLI in background (optional - for interactive debugging)
    // Uncomment to enable interactive CLI:
    // cli->Start();
    // std::cout << "  Interactive CLI started in background\n";
    // std::cout << "  Type 'continue', 'step', 'print <var>', 'list', 'help', etc.\n\n";

    // For this example, we'll auto-continue at breakpoints
    std::thread autoDebugger([&debugSession]() {
        while (debugSession->IsActive()) {
            if (debugSession->IsPaused()) {
                std::cout << "\n  [Debugger] Breakpoint hit! Auto-continuing after 1 second...\n";
                std::cout << "  [Debugger] Current step: " << debugSession->GetCurrentStepName() << "\n";

                // Show call stack
                auto callStack = debugSession->GetCallStack();
                if (!callStack.empty()) {
                    std::cout << "  [Debugger] Call stack:\n";
                    for (size_t i = 0; i < callStack.size(); ++i) {
                        std::cout << "    #" << i << " " << callStack[i].stepId
                                  << " (" << callStack[i].stepName << ")\n";
                    }
                }

                // Wait a moment to show the pause
                std::this_thread::sleep_for(std::chrono::milliseconds(1000));

                // Auto-continue
                debugSession->Continue();
            }

            std::this_thread::sleep_for(std::chrono::milliseconds(100));
        }
    });

    // Execute the test sequence
    SExecutionConfig config;
    config.processModel = EProcessModelType::kSequential;
    config.stopOnFirstFailure = false;

    auto result = executor.Execute(sequence, config);

    // Wait for debug thread to finish
    debugSession->Finish();
    autoDebugger.join();

    // ------------------------------------------------------------------------
    // Step 5: Show results
    // ------------------------------------------------------------------------
    std::cout << "\n[5] Execution complete!\n\n";

    const auto& report = executor.GetReport();
    std::cout << "====================================================\n";
    std::cout << "  Test Report\n";
    std::cout << "====================================================\n";
    std::cout << "Sequence: " << report.sequenceName << "\n";
    std::cout << "Overall: " << (report.overallVerdict == ETestVerdict::kPass ? "PASS" : "FAIL") << "\n";
    std::cout << "Duration: " << report.totalDurationMs << " ms\n";
    std::cout << "Results: " << report.passCount << " pass, "
              << report.failCount << " fail, "
              << report.skipCount << " skip\n";
    std::cout << "====================================================\n\n";

    // Show debug statistics
    auto debugStats = debugSession->GetStats();
    std::cout << "====================================================\n";
    std::cout << "  Debug Statistics\n";
    std::cout << "====================================================\n";
    std::cout << "Steps executed: " << debugStats.stepsExecuted << "\n";
    std::cout << "Breakpoints hit: " << debugStats.breakpointsHit << "\n";
    std::cout << "Exceptions: " << debugStats.exceptionsOccurred << "\n";
    std::cout << "Total debug time: " << debugStats.executionTimeMs << " ms\n";
    std::cout << "====================================================\n\n";

    // Show breakpoint report
    std::cout << "====================================================\n";
    std::cout << "  Breakpoint Report\n";
    std::cout << "====================================================\n";
    std::cout << breakpointManager->GenerateReport();
    std::cout << "====================================================\n\n";

    std::cout << "Example complete!\n";

    return 0;
}
