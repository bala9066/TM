{
  "id": "SEMI-PARAM-001",
  "name": "Semiconductor Parametric Test Sequence",
  "version": "3.2.1",
  "steps": [
    {"id": "SETUP-001", "name": "Load Handler", "type": "action", "enabled": true},
    {"id": "SETUP-002", "name": "Configure Test Head", "type": "action", "enabled": true},
    {"id": "SETUP-003", "name": "Set Contact Force", "type": "action", "enabled": true},
    {"id": "SETUP-004", "name": "Verify Contact Resistance", "type": "validation", "enabled": true},

    {"id": "CONT-001", "name": "Continuity Test - Pin 1", "type": "measurement", "enabled": true},
    {"id": "CONT-002", "name": "Continuity Test - Pin 2", "type": "measurement", "enabled": true},
    {"id": "CONT-003", "name": "Continuity Test - All Pins", "type": "validation", "enabled": true},

    {"id": "LEAK-001", "name": "Leakage Test - Apply Reverse Bias", "type": "action", "enabled": true},
    {"id": "LEAK-002", "name": "Leakage Test - Measure IDSS", "type": "measurement", "enabled": true},
    {"id": "LEAK-003", "name": "Leakage Test - Validate < 10nA", "type": "validation", "enabled": true},
    {"id": "LEAK-004", "name": "Leakage Test - Measure IGSS", "type": "measurement", "enabled": true},
    {"id": "LEAK-005", "name": "Leakage Test - Validate < 1nA", "type": "validation", "enabled": true},

    {"id": "VTH-001", "name": "Threshold Voltage - Set Test Conditions", "type": "action", "enabled": true},
    {"id": "VTH-002", "name": "Threshold Voltage - Sweep VGS", "type": "measurement", "enabled": true},
    {"id": "VTH-003", "name": "Threshold Voltage - Calculate VTH", "type": "measurement", "enabled": true},
    {"id": "VTH-004", "name": "Threshold Voltage - Validate 2.0V < VTH < 4.0V", "type": "validation", "enabled": true},

    {"id": "RDS-001", "name": "On-Resistance - Apply VGS = 10V", "type": "action", "enabled": true},
    {"id": "RDS-002", "name": "On-Resistance - Force ID = 10A", "type": "action", "enabled": true},
    {"id": "RDS-003", "name": "On-Resistance - Measure VDS", "type": "measurement", "enabled": true},
    {"id": "RDS-004", "name": "On-Resistance - Calculate RDS(on)", "type": "measurement", "enabled": true},
    {"id": "RDS-005", "name": "On-Resistance - Validate < 100mΩ", "type": "validation", "enabled": true},

    {"id": "BV-001", "name": "Breakdown Voltage - Set VGS = 0V", "type": "action", "enabled": true},
    {"id": "BV-002", "name": "Breakdown Voltage - Sweep VDS", "type": "measurement", "enabled": true},
    {"id": "BV-003", "name": "Breakdown Voltage - Detect Breakdown", "type": "measurement", "enabled": true},
    {"id": "BV-004", "name": "Breakdown Voltage - Validate BVDSS > 600V", "type": "validation", "enabled": true},

    {"id": "CAP-001", "name": "Capacitance - Measure CISS @ 1MHz", "type": "measurement", "enabled": true},
    {"id": "CAP-002", "name": "Capacitance - Validate CISS", "type": "validation", "enabled": true},
    {"id": "CAP-003", "name": "Capacitance - Measure COSS @ 1MHz", "type": "measurement", "enabled": true},
    {"id": "CAP-004", "name": "Capacitance - Validate COSS", "type": "validation", "enabled": true},
    {"id": "CAP-005", "name": "Capacitance - Measure CRSS @ 1MHz", "type": "measurement", "enabled": true},
    {"id": "CAP-006", "name": "Capacitance - Validate CRSS", "type": "validation", "enabled": true},

    {"id": "DIODE-001", "name": "Body Diode - Force IF = 10A", "type": "action", "enabled": true},
    {"id": "DIODE-002", "name": "Body Diode - Measure VF", "type": "measurement", "enabled": true},
    {"id": "DIODE-003", "name": "Body Diode - Validate VF < 1.5V", "type": "validation", "enabled": true},
    {"id": "DIODE-004", "name": "Body Diode - Measure trr", "type": "measurement", "enabled": true},
    {"id": "DIODE-005", "name": "Body Diode - Validate trr < 100ns", "type": "validation", "enabled": true},

    {"id": "FIN-001", "name": "Finalize - Unload Device", "type": "action", "enabled": true},
    {"id": "FIN-002", "name": "Finalize - Bin Device", "type": "action", "enabled": true},
    {"id": "FIN-003", "name": "Finalize - Write STDF Record", "type": "action", "enabled": true}
  ]
}
